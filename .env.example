# ─── Spring Boot ───────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx512m

# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=viora_streaming_db
POSTGRES_USER=viora_streaming_user
POSTGRES_PASSWORD=viora_streaming_password
POSTGRES_PORT=5432

# ─── Streaming ──────────────────────────────────
# Absolute path to the folder containing per-movie segment subdirectories.
# The directory MUST exist before running docker-compose (run: mkdir -p <your-path>).
MOVIES_PATH=/path/to/your/movies/segments

# ─── React ──────────────────────────────────────
REACT_APP_API_URL=http://localhost:8080
REACT_APP_ENV=production
FRONTEND_PORT=80
